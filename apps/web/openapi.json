{
  "components": {
    "schemas": {
      "AddMemberRequest": {
        "properties": {
          "email": {
            "description": "Email of an existing Studio account.",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "ChangeRoleRequest": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "CreateProjectRequest": {
        "properties": {
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "key": {
            "maxLength": 40,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "key",
          "name"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable, machine-readable code, e.g. `DECISION_NOT_FOUND`.",
            "type": "string"
          },
          "details": {
            "description": "Engine error document (failing node and reason) for evaluation failures."
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "message": {
            "description": "Safe to show to a person.",
            "type": "string"
          },
          "requestId": {
            "description": "Same value as the `x-request-id` response header; quote it when reporting a problem.",
            "type": "string"
          }
        },
        "required": [
          "message",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "InvitationRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "locale": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Locale",
                "description": "Language of the invitation email and of the account. Defaults to the inviter's."
              }
            ]
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "Locale": {
        "description": "Language of a user's emails and screens.",
        "enum": [
          "en",
          "fr"
        ],
        "type": "string"
      },
      "MemberListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "MemberResponse": {
        "properties": {
          "addedAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "email",
          "role",
          "addedAt"
        ],
        "type": "object"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "PasswordSetupRequest": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "token": {
            "description": "The token from the password-setup link.",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "ProjectListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectSummaryResponse"
            },
            "type": "array"
          },
          "total": {
            "description": "Projects matching the filter, across all pages.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "ProjectResponse": {
        "properties": {
          "archivedAt": {
            "description": "Set when the project is archived (read-only).",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "key": {
            "description": "Immutable, URL-safe identifier.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The reader's role in the project."
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "description",
          "createdAt",
          "role"
        ],
        "type": "object"
      },
      "ProjectSummaryResponse": {
        "properties": {
          "archivedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "description",
          "role"
        ],
        "type": "object"
      },
      "Role": {
        "description": "What a member may do in a project. Each role includes the ones below it;\nvariants are declared from least to most, so `Ord` follows that order.",
        "enum": [
          "viewer",
          "editor",
          "owner"
        ],
        "type": "string"
      },
      "SignInRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "SimulateRequest": {
        "description": "Design-time evaluation from the editor. The editor sends the whole draft\nproject so sub-decision references resolve exactly as they will in a release.",
        "properties": {
          "context": {
            "description": "Input passed to the decision.",
            "type": "object"
          },
          "decisions": {
            "description": "Every decision of the project (JDM documents), keyed as graphs reference them.",
            "type": "object"
          },
          "key": {
            "description": "The decision to evaluate.",
            "type": "string"
          }
        },
        "required": [
          "decisions",
          "key"
        ],
        "type": "object"
      },
      "SimulateResponse": {
        "properties": {
          "performance": {
            "description": "Engine evaluation time, e.g. `412.5µs`.",
            "type": "string"
          },
          "result": {
            "type": "object"
          },
          "trace": {
            "description": "Per-node trace: inputs, outputs and timing of each node.",
            "type": "object"
          }
        },
        "required": [
          "result",
          "trace",
          "performance"
        ],
        "type": "object"
      },
      "UpdateProjectRequest": {
        "properties": {
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": [
          "id",
          "email",
          "isAdmin",
          "locale"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "version": {
            "description": "Release version baked in at build time, or `unknown` for a local build.",
            "example": "1.4.0",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Control plane of Donka: authoring, simulation, releases.",
    "license": {
      "name": ""
    },
    "title": "Donka Studio API",
    "version": "unknown"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in (UNAUTHENTICATED)"
          }
        },
        "summary": "The signed-in user.",
        "tags": [
          "identity"
        ]
      }
    },
    "/auth/password-reset": {
      "post": {
        "operationId": "password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "If the address has an account, a reset link is on its way"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an email address (INVALID_REQUEST)"
          }
        },
        "summary": "Emails a one-time link to choose a new password. Answers the same whether or\nnot the address has an account, so it cannot be used to find accounts.",
        "tags": [
          "identity"
        ]
      }
    },
    "/auth/password-setup": {
      "post": {
        "operationId": "password_setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password set; sign in with it"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Link invalid, used or expired (INVALID_SETUP_LINK), or password too short or too long (INVALID_REQUEST)"
          }
        },
        "summary": "Sets a password from a one-time setup link. Ends the user's other sessions.",
        "tags": [
          "identity"
        ]
      }
    },
    "/auth/sign-in": {
      "post": {
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Signed in; the session cookie is set"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Email or password is incorrect, or the account is locked (INVALID_CREDENTIALS)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing CSRF header (CSRF_REQUIRED)"
          }
        },
        "summary": "Signs in and sets the httpOnly session cookie.",
        "tags": [
          "identity"
        ]
      }
    },
    "/auth/sign-out": {
      "post": {
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in (UNAUTHENTICATED)"
          }
        },
        "summary": "Ends the session on the server and clears the cookie.",
        "tags": [
          "identity"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "example": "ok",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The service is running"
          }
        },
        "summary": "Liveness: answers as long as the process serves requests. Does not touch the database.",
        "tags": [
          "operations"
        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "description": "`true` lists archived projects instead of active ones.",
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Page size, 1 to 100 (default 50).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in (UNAUTHENTICATED)"
          }
        },
        "summary": "Projects the signed-in user is a member of, by name.",
        "tags": [
          "projects"
        ]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid key, name or description (INVALID_REQUEST)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator (FORBIDDEN)"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Key already used (PROJECT_KEY_TAKEN)"
          }
        },
        "summary": "Creates a project (administrators only). The creator becomes its owner.",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}": {
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such project, or not a member (PROJECT_NOT_FOUND)"
          }
        },
        "summary": "A project the signed-in user is a member of.",
        "tags": [
          "projects"
        ]
      },
      "patch": {
        "operationId": "update",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid name or description (INVALID_REQUEST)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an owner (FORBIDDEN)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PROJECT_NOT_FOUND"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Archived (PROJECT_ARCHIVED)"
          }
        },
        "summary": "Renames the project or changes its description (owners). The key never changes.",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}/archive": {
      "post": {
        "operationId": "archive",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an owner (FORBIDDEN)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PROJECT_NOT_FOUND"
          }
        },
        "summary": "Archives the project: read-only and hidden from the default list (owners).",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}/members": {
      "get": {
        "operationId": "members",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberListResponse"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PROJECT_NOT_FOUND"
          }
        },
        "summary": "Members of the project, owners first, then by email (any member).",
        "tags": [
          "projects"
        ]
      },
      "post": {
        "operationId": "add_member",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an owner (FORBIDDEN)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PROJECT_NOT_FOUND"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Already a member (ALREADY_MEMBER) or archived (PROJECT_ARCHIVED)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No account with this email (NO_SUCH_USER)"
          }
        },
        "summary": "Adds an existing Studio user to the project (owners).",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}/members/{user_id}": {
      "delete": {
        "operationId": "remove_member",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
