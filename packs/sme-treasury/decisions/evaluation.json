            "knockoutsi2": "",
            "knockoutsi3": "",
            "knockoutsi4": "",
            "knockoutso0": "\"K11\"",
            "knockoutso1": "\"The business is younger than the minimum.\"",
            "knockoutso2": "\"L'entreprise est plus jeune que le minimum.\""
          },
          {
            "_id": "knockoutsr1",
            "knockoutsi0": "",
            "knockoutsi1": "<= 0",
            "knockoutsi2": "",
            "knockoutsi3": "",
            "knockoutsi4": "",
            "knockoutso0": "\"K12\"",
            "knockoutso1": "\"No turnover on record.\"",
            "knockoutso2": "\"Aucun chiffre d'affaires enregistré.\""
          },
          {
            "_id": "knockoutsr2",
            "knockoutsi0": "",
            "knockoutsi1": "",
            "knockoutsi2": "< 1",
            "knockoutsi3": "",
            "knockoutsi4": "",
            "knockoutso0": "\"K13\"",
            "knockoutso1": "\"Cash flow does not cover the repayments.\"",
            "knockoutso2": "\"La trésorerie ne couvre pas les remboursements.\""
          },
          {
            "_id": "knockoutsr3",
            "knockoutsi0": "",
            "knockoutsi1": "",
            "knockoutsi2": "",
            "knockoutsi3": "> policy.maxDaysPastDue",
            "knockoutsi4": "",
            "knockoutso0": "\"K14\"",
            "knockoutso1": "\"The bureau reports serious arrears.\"",
            "knockoutso2": "\"Le bureau de crédit signale des impayés graves.\""
          },
          {
            "_id": "knockoutsr4",
            "knockoutsi0": "",
            "knockoutsi1": "",
            "knockoutsi2": "",
            "knockoutsi3": "",
            "knockoutsi4": "> policy.maxPaymentIncidents",
            "knockoutso0": "\"K15\"",
            "knockoutso1": "\"Too many payment incidents (e.g. returned cheques).\"",
            "knockoutso2": "\"Trop d'incidents de paiement (par exemple chèques impayés).\""
          }
        ],
        "outputPath": "knockouts"
      },
