            "field": "business.yearsActive"
          }
        ],
        "outputs": [
          {
            "id": "yearso0",
            "name": "Points",
            "field": "points.years"
          }
        ],
        "rules": [
          {
            "_id": "yearsr0",
            "yearsi0": "< 2",
            "yearso0": "0"
          },
          {
            "_id": "yearsr1",
            "yearsi0": "[2..5)",
            "yearso0": "10"
          },
          {
            "_id": "yearsr2",
            "yearsi0": "[5..10)",
            "yearso0": "20"
          },
          {
            "_id": "yearsr3",
            "yearsi0": "",
            "yearso0": "25"
          }
        ]
      },
      "position": {
        "x": 320,
        "y": 180
      }
    },
