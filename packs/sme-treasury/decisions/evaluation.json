{
  "nodes": [
    {
      "id": "request",
      "type": "inputNode",
      "name": "Request",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "policy",
      "type": "expressionNode",
      "name": "Credit policy",
      "content": {
        "expressions": [
          {
            "id": "policy0",
            "key": "minYearsActive",
            "value": "2"
          },
          {
            "id": "policy1",
            "key": "minDebtServiceCover",
            "value": "1.2"
          },
          {
            "id": "policy2",
            "key": "maxDaysPastDue",
            "value": "90"
          },
          {
            "id": "policy3",
            "key": "maxPaymentIncidents",
            "value": "2"
          },
          {
            "id": "policy4",
            "key": "annualRate",
            "value": "0.14"
          }
        ],
        "passThrough": true,
        "outputPath": "policy"
      },
      "position": {
        "x": 320,
        "y": 0
      }
    },
    {
      "id": "sector",
      "type": "decisionTableNode",
      "name": "Sector factors",
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "sectori0",
            "name": "Sector",
            "field": "business.sector"
          }
        ],
        "outputs": [
          {
            "id": "sectoro0",
            "name": "Limit share of turnover",
            "field": "sector.limitShare"
          },
          {
            "id": "sectoro1",
            "name": "Cash margin",
            "field": "sector.cashMargin"
          }
        ],
        "rules": [
          {
            "_id": "sectorr0",
            "sectori0": "\"trade\"",
            "sectoro0": "0.30",
            "sectoro1": "0.10"
          },
          {
            "_id": "sectorr1",
            "sectori0": "\"services\"",
            "sectoro0": "0.25",
            "sectoro1": "0.20"
          },
          {
            "_id": "sectorr2",
            "sectori0": "\"manufacturing\"",
            "sectoro0": "0.25",
            "sectoro1": "0.15"
          },
          {
            "_id": "sectorr3",
            "sectori0": "\"agriculture\"",
            "sectoro0": "0.20",
            "sectoro1": "0.15"
          },
          {
            "_id": "sectorr4",
            "sectori0": "\"construction\"",
            "sectoro0": "0.20",
            "sectoro1": "0.12"
          },
          {
            "_id": "sectorr5",
            "sectori0": "",
            "sectoro0": "0.15",
            "sectoro1": "0.10"
          }
        ]
      },
      "position": {
        "x": 640,
        "y": 0
      }
    },
    {
      "id": "service",
      "type": "expressionNode",
      "name": "New debt service",
      "content": {
        "expressions": [
          {
            "id": "service0",
            "key": "newDebtService",
            "value": "request.product == 'overdraft' ? round(request.amount * policy.annualRate / 12) : round(request.amount * (policy.annualRate / 12) / (1 - (1 + policy.annualRate / 12) ^ (-request.termMonths)))"
          },
          {
            "id": "service1",
            "key": "capacityLimit",
            "value": "floor(business.monthlyTurnover * sector.limitShare / 100000) * 100000"
          },
          {
            "id": "service2",
            "key": "monthlyCashFlow",
            "value": "round(business.monthlyTurnover * sector.cashMargin)"
          }
        ],
        "passThrough": true,
        "outputPath": "calc"
      },
      "position": {
        "x": 960,
        "y": 0
      }
    },
    {
      "id": "cover",
      "type": "expressionNode",
      "name": "Cover ratios",
      "content": {
        "expressions": [
          {
            "id": "cover0",
            "key": "debtServiceCover",
            "value": "round(calc.monthlyCashFlow / (business.monthlyDebtService + calc.newDebtService) * 100) / 100"
          },
          {
            "id": "cover1",
            "key": "balanceCover",
            "value": "round(business.averageBalance / (business.monthlyDebtService + calc.newDebtService) * 100) / 100"
          },
          {
            "id": "cover2",
            "key": "recommendedLimit",
            "value": "min([request.amount, calc.capacityLimit])"
          }
        ],
        "passThrough": true,
        "outputPath": "ratios"
      },
      "position": {
        "x": 0,
        "y": 180
      }
    },
    {
      "id": "years",
      "type": "decisionTableNode",
