    {
      "id": "request",
      "type": "inputNode",
      "name": "Request",
      "position": {
        "x": 0,
        "y": 0
      },
      "content": {
        "schema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"required\": [\n    \"customer\",\n    \"account\",\n    \"screening\",\n    \"documents\"\n  ],\n  \"properties\": {\n    \"customer\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"type\",\n        \"residence\",\n        \"nationality\",\n        \"activity\",\n        \"pep\",\n        \"yearsKnown\"\n      ],\n      \"properties\": {\n        \"type\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"individual\",\n            \"business\"\n          ],\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Customer type\",\n              \"fr\": \"Type de client\"\n            }\n          }\n        },\n        \"residence\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[A-Z]{2}$\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Country of residence (ISO code)\",\n              \"fr\": \"Pays de résidence (code ISO)\"\n            },\n            \"help\": {\n              \"en\": \"Two letters, e.g. CM, GA, FR.\",\n              \"fr\": \"Deux lettres, p. ex. CM, GA, FR.\"\n            }\n          }\n        },\n        \"nationality\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[A-Z]{2}$\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Nationality or country of registration (ISO code)\",\n              \"fr\": \"Nationalité ou pays d'immatriculation (code ISO)\"\n            }\n          }\n        },\n        \"activity\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"salaried\",\n            \"civil-servant\",\n            \"self-employed\",\n            \"trader\",\n            \"ngo\",\n            \"cash-intensive\",\n            \"other\"\n          ],\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Occupation or business activity\",\n              \"fr\": \"Profession ou activité\"\n            },\n            \"help\": {\n              \"en\": \"cash-intensive: money changers, precious metals, real estate, car dealers, casinos.\",\n              \"fr\": \"cash-intensive : changeurs, métaux précieux, immobilier, concessionnaires, casinos.\"\n            }\n          }\n        },\n        \"pep\": {\n          \"type\": \"boolean\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Politically exposed person, family or close associate\",\n              \"fr\": \"Personne politiquement exposée, famille ou proche\"\n            }\n          }\n        },\n        \"yearsKnown\": {\n          \"type\": \"number\",\n          \"minimum\": 0,\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Years as a customer\",\n              \"fr\": \"Ancienneté de la relation (années)\"\n            }\n          }\n        },\n        \"beneficialOwnersIdentified\": {\n          \"type\": \"boolean\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Beneficial owners identified (businesses)\",\n              \"fr\": \"Bénéficiaires effectifs identifiés (entreprises)\"\n            },\n            \"help\": {\n              \"en\": \"Everyone who owns or controls 25% or more.\",\n              \"fr\": \"Toute personne qui détient ou contrôle 25 % ou plus.\"\n            }\n          }\n        }\n      }\n    },\n    \"account\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"channel\",\n        \"expectedMonthlyVolume\"\n      ],\n      \"properties\": {\n        \"channel\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"branch\",\n            \"agent\",\n            \"online\"\n          ],\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Onboarding channel\",\n              \"fr\": \"Canal d'entrée en relation\"\n            }\n          }\n        },\n        \"expectedMonthlyVolume\": {\n          \"type\": \"number\",\n          \"minimum\": 0,\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Expected monthly volume (XAF)\",\n              \"fr\": \"Volume mensuel attendu (XAF)\"\n            }\n          }\n        }\n      }\n    },\n    \"screening\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"sanctionsHit\",\n        \"adverseMedia\"\n      ],\n      \"properties\": {\n        \"sanctionsHit\": {\n          \"type\": \"boolean\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Confirmed match on a sanctions list\",\n              \"fr\": \"Correspondance confirmée sur une liste de sanctions\"\n            }\n          }\n        },\n        \"adverseMedia\": {\n          \"type\": \"boolean\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Adverse media found\",\n              \"fr\": \"Informations négatives dans les médias\"\n            }\n          }\n        }\n      }\n    },\n    \"documents\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"identityVerified\",\n        \"addressVerified\"\n      ],\n      \"properties\": {\n        \"identityVerified\": {\n          \"type\": \"boolean\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Identity document verified\",\n              \"fr\": \"Pièce d'identité vérifiée\"\n            }\n          }\n        },\n        \"addressVerified\": {\n          \"type\": \"boolean\",\n          \"x-donka\": {\n            \"label\": {\n              \"en\": \"Address verified\",\n              \"fr\": \"Adresse vérifiée\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"
