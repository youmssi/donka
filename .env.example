# Copy to .env and adjust.
DONKA_LISTEN=0.0.0.0:8080
# Versioned prefix of every endpoint. Must start with '/' and not end with '/'.
DONKA_API_BASE_PATH=/api/v1
# DONKA_ENGINE_WORKERS=4          # defaults to the number of CPUs
# Warnings from every crate; info from Donka's own modules and the HTTP access log.
RUST_LOG=warn,donka_app=info,donka_identity=info,tower_http=info

# PostgreSQL 16. Required. Contains credentials: never commit a real one.
DATABASE_URL=postgres://donka:donka@localhost:5432/donka
# Apply pending migrations at startup (true/false).
DONKA_DB_MIGRATE=true
# Connection pool size.
DONKA_DB_MAX_CONNECTIONS=10

# Where people reach Studio; used to build links such as password setup.
DONKA_PUBLIC_URL=http://localhost:8080
# Session cookie only over HTTPS. Set to false only for local HTTP development.
DONKA_COOKIE_SECURE=true
# A session ends after this many minutes without activity.
DONKA_SESSION_IDLE_MINUTES=480
# Failed sign-ins (within 15 minutes) before the account locks, and for how long.
DONKA_SIGN_IN_MAX_FAILURES=5
DONKA_SIGN_IN_LOCK_MINUTES=15
# On an empty database, create this administrator and print a one-time password-setup link.
# DONKA_BOOTSTRAP_ADMIN_EMAIL=admin@bank.example
# Language (en or fr) of the first administrator; invited people get the one chosen for them.
DONKA_DEFAULT_LOCALE=en
# How long invitation links (hours) and password-reset links (minutes) work.
DONKA_INVITATION_LINK_HOURS=72
DONKA_PASSWORD_RESET_LINK_MINUTES=30

# Outgoing email (invitations, password reset). Required.
# smtp://host:port (no TLS, e.g. Mailpit or a local relay), smtp://user:pass@host:587?tls=required
# (STARTTLS) or smtps://user:pass@host:465. Contains credentials: never commit a real one.
DONKA_SMTP_URL=smtp://localhost:1025
DONKA_SMTP_FROM=Donka <donka@localhost>
# Failed sends (retried with backoff up to one hour apart) before an email (account or approval
# request) is abandoned.
DONKA_EMAIL_MAX_ATTEMPTS=10

# Serve the web app's static export from this directory (the image sets /srv/web).
# Leave unset in development: run `pnpm --dir apps/web dev` (it forwards /api to DONKA_LISTEN).
# DONKA_WEB_DIR=apps/web/out

# Where releases are published, one object per project and environment (<env>/<project-key>).
# Required. s3://<bucket>[/<prefix>] for S3 or an S3-compatible store (MinIO, Ceph…), or
# file:///absolute/path for a single-server install.
DONKA_STORAGE_URL=s3://donka-releases
# S3 settings; leave unset to use the standard AWS environment, instance or pod credentials.
# An http:// endpoint is allowed (MinIO on a private network).
DONKA_STORAGE_ENDPOINT=http://localhost:9000
DONKA_STORAGE_REGION=us-east-1
DONKA_STORAGE_ACCESS_KEY_ID=donka
# Contains a credential: never commit a real one.
DONKA_STORAGE_SECRET_ACCESS_KEY=donka-secret
# Failed publishes (retried with backoff up to one hour apart) before a deployment gives up.
DONKA_PUBLISH_MAX_ATTEMPTS=10

# Decision log: what each decision read and answered is encrypted with this key. Required:
# 32 random bytes in base64 (`openssl rand -base64 32`). Records cannot be read without it,
# so keep it in the installation's secret store. This value is for local development only.
DONKA_DECISION_LOG_KEY=cVJvqYsVeZAWH3ozwFWpgWbLUS5bhWIY88xqwroQSTQ=
# Days a decision record is kept before it is purged (each purge is audited). Default: five years.
DONKA_DECISION_LOG_RETENTION_DAYS=1825

# OpenTelemetry (off by default): traces and request metrics exported over OTLP (HTTP).
# Where to send them comes from the standard OpenTelemetry variables, e.g.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ...
# Spans carry the request id and route template, never paths, query strings or bodies.
DONKA_OTEL_ENABLED=false

# Explanations (off by default): a logged decision is explained in plain language by the
# installation's own LLM endpoint. Setting the URL turns them on; then the key, the request
# format and the model are required. Before a record is sent, each project's redacted fields
# are removed, and every explanation is audited. The model gets no tools: it cannot change
# a decision.
# DONKA_EXPLAIN_URL=https://api.anthropic.com/v1/messages
# Contains a credential: never commit a real one.
# DONKA_EXPLAIN_API_KEY=
# `anthropic` (Messages API) or `openai` (OpenAI-compatible chat completions, which most
# self-hosted models serve, e.g. https://llm.bank.internal/v1/chat/completions).
# DONKA_EXPLAIN_API=anthropic
# The model name the endpoint expects.
# DONKA_EXPLAIN_MODEL=claude-opus-5-5
# Seconds to wait for an explanation.
# DONKA_EXPLAIN_TIMEOUT_SECONDS=60
# Anthropic's own API only: answer a request one model declines with another (`fallbacks`).
# DONKA_EXPLAIN_FALLBACKS=false
