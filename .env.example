# Settings for running Studio from source (cargo run): copy to .env and adjust.
# For the Docker Compose install, see docs/install.md: donka-admin init writes its .env from
# donka.yaml, with the secrets as files in secrets/; other settings from this list go in
# docker-compose.override.yml.
#
# Every secret setting X can instead be given as X_FILE, the path of a file holding the value
# (Docker or Kubernetes secrets, a vault agent): DATABASE_URL, DONKA_SMTP_URL,
# DONKA_STORAGE_ACCESS_KEY_ID, DONKA_STORAGE_SECRET_ACCESS_KEY, DONKA_DECISION_LOG_KEY,
# DONKA_DECISION_LOG_PREVIOUS_KEYS, DONKA_PERSON_INDEX_KEY, DONKA_SECOND_STEP_KEY,
# DONKA_SECOND_STEP_PREVIOUS_KEYS and DONKA_EXPLAIN_API_KEY. Trailing newlines are removed.
# Setting both X and X_FILE, or a file Studio cannot read, stops Studio at start.
#   DONKA_DECISION_LOG_KEY_FILE=/run/secrets/decision_log_key
DONKA_LISTEN=0.0.0.0:8080
# Versioned prefix of every endpoint. Must start with '/' and not end with '/'.
DONKA_API_BASE_PATH=/api/v1
# DONKA_ENGINE_WORKERS=4          # defaults to the number of CPUs
# Warnings from every crate; info from Donka's own modules and the HTTP access log.
RUST_LOG=warn,donka_app=info,donka_identity=info,tower_http=info

# PostgreSQL 16. Required. Contains credentials: never commit a real one.
DATABASE_URL=postgres://donka:donka@localhost:5432/donka
# Apply pending migrations at startup (true/false).
DONKA_DB_MIGRATE=true
# Connection pool size.
DONKA_DB_MAX_CONNECTIONS=10

# Where people reach Studio; used to build links such as password setup.
DONKA_PUBLIC_URL=http://localhost:8080
# Session cookie only over HTTPS. Set to false only for local HTTP development.
DONKA_COOKIE_SECURE=true
# A session ends after this many minutes without activity.
DONKA_SESSION_IDLE_MINUTES=480
# Failed sign-ins (within 15 minutes) before the account locks, and for how long.
DONKA_SIGN_IN_MAX_FAILURES=5
DONKA_SIGN_IN_LOCK_MINUTES=15
# Two-step sign-in with an authenticator app (DNK-59). Who must use it: none (default; anyone
# may still turn it on), privileged (instance administrators and project owners) or all.
# A person the policy covers sets it up right after their password at the next sign-in.
DONKA_MFA_REQUIRED=none
# Seals each person's authenticator secret. Required: 32 random bytes in base64
# (`openssl rand -base64 32`). Without it nobody with a second step can sign in, so keep it in
# the installation's secret store and in backups. This value is for local development only.
DONKA_SECOND_STEP_KEY=0zZcVkJ0ShW8Xr0PI3jIlvd8Cpz9rKpnSp4iQCbwg6Y=
# After a key rotation: the previous keys, separated by commas. Each secret is re-sealed with
# the key above the next time its owner signs in. Empty by default.
DONKA_SECOND_STEP_PREVIOUS_KEYS=
# Requests per minute from one client address to sign-in and to password reset; beyond them the
# API answers 429 with Retry-After. Counted per Studio instance.
DONKA_SIGN_IN_RATE_LIMIT=10
DONKA_PASSWORD_RESET_RATE_LIMIT=5
# Reverse proxies in front of Studio, as addresses or CIDR ranges (comma-separated). Only their
# X-Forwarded-For header names the client; without this, every client behind a proxy shares
# the proxy's address, and so its limits.
# DONKA_TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12
# On an empty database, create this administrator and print a one-time password-setup link.
# DONKA_BOOTSTRAP_ADMIN_EMAIL=admin@bank.example
# Language (en or fr) of the first administrator; invited people get the one chosen for them.
DONKA_DEFAULT_LOCALE=en
# How long invitation links (hours) and password-reset links (minutes) work.
DONKA_INVITATION_LINK_HOURS=72
DONKA_PASSWORD_RESET_LINK_MINUTES=30

# Outgoing email (invitations, password reset). Required.
# smtp://host:port (no TLS, e.g. Mailpit or a local relay), smtp://user:pass@host:587?tls=required
# (STARTTLS) or smtps://user:pass@host:465. Contains credentials: never commit a real one.
DONKA_SMTP_URL=smtp://localhost:1025
DONKA_SMTP_FROM=Donka <donka@localhost>
# Failed sends (retried with backoff up to one hour apart) before an email (account or approval
# request) is abandoned.
DONKA_EMAIL_MAX_ATTEMPTS=10

# Serve the web app's static export from this directory (the image sets /srv/web).
# Leave unset in development: run `pnpm --dir apps/web dev` (it forwards /api to DONKA_LISTEN).
# DONKA_WEB_DIR=apps/web/out

# Packs offered when a project is created, one folder per pack (packs/README.md). Optional:
# none are offered when unset, and projects can still be made from a pack file. The image sets
# /srv/packs, which holds this repository's packs. Studio does not start if a pack is invalid.
# DONKA_PACKS_DIR=packs

# The licence file Donka issued for this installation (DNK-77), verified offline at start, daily
# and on SIGHUP. Optional: without it Studio runs in evaluation, where releases cannot reach
# production. An expired, changed or foreign licence keeps Studio readable but refuses new
# versions and releases; the Runtime is never affected.
# DONKA_LICENCE_FILE=/etc/donka/licence.json
# The optional modules turned on, within the licence (DNK-74): explain, connectors, analysis,
# separated by commas. Unset: every module the licence includes. Empty: none. A change takes
# effect at the next start, which records it in the audit log; a module turned off keeps its data.
# DONKA_MODULES=explain,analysis

# Whether a newer Donka release is published (DNK-64): Studio asks the release feed when it starts
# and once a day, and tells administrators. Set to false on a server without internet access
# (donka-admin init --offline does); the URL is GitHub's Releases API for Donka Studio unless set.
# DONKA_UPDATE_CHECK=true
# DONKA_UPDATE_CHECK_URL=https://api.github.com/repos/youmssi/donka/releases/latest

# Where Studio writes, at its first start, the decision-log token of the staging Runtime it is
# installed with (DNK-64); the Runtime reads it with DECISION_LOG__TOKEN_FILE. Issued once, as
# DONKA_BOOTSTRAP_ADMIN_EMAIL; an existing file is kept. The installation's docker-compose.yml
# (donka-admin init) sets it. Unset: an administrator issues Runtime tokens in Studio.
# DONKA_RUNTIME_LOG_TOKEN_FILE=/var/lib/donka/wiring/staging-decision-log-token

# The demo (donka-admin init --demo, DNK-64): at the first start, the retail-credit pack is
# imported, released and deployed to staging as DONKA_BOOTSTRAP_ADMIN_EMAIL. Default false.
# DONKA_DEMO=true

# Where releases are published, one object per project and environment (<env>/<project-key>).
# Required. s3://<bucket>[/<prefix>] for S3 or an S3-compatible store (MinIO, Ceph…), or
# file:///absolute/path for a single-server install.
DONKA_STORAGE_URL=s3://donka-releases
# S3 settings; leave unset to use the standard AWS environment, instance or pod credentials.
# An http:// endpoint is allowed (MinIO on a private network).
DONKA_STORAGE_ENDPOINT=http://localhost:9000
DONKA_STORAGE_REGION=us-east-1
DONKA_STORAGE_ACCESS_KEY_ID=donka
# Contains a credential: never commit a real one.
DONKA_STORAGE_SECRET_ACCESS_KEY=donka-secret
# Failed publishes (retried with backoff up to one hour apart) before a deployment gives up.
DONKA_PUBLISH_MAX_ATTEMPTS=10

# Decision log: what each decision read and answered is encrypted with this key. Required:
# 32 random bytes in base64 (`openssl rand -base64 32`). Records cannot be read without it,
# so keep it in the installation's secret store. This value is for local development only.
DONKA_DECISION_LOG_KEY=cVJvqYsVeZAWH3ozwFWpgWbLUS5bhWIY88xqwroQSTQ=
# After a key rotation: the keys records were sealed with before, separated by commas. They only
# open those records until `donka-app decision-log reseal` re-seals them with the key above
# (docs/install.md, Rotate secrets). Empty by default.
DONKA_DECISION_LOG_PREVIOUS_KEYS=
# People are found in the decision log by the identifiers the contract marks (national ID,
# phone…), through keyed hashes made with this key. Required: 32 random bytes in base64
# (`openssl rand -base64 32`). Changing it means indexing the log again
# (`donka-app decision-log index-people`). This value is for local development only.
DONKA_PERSON_INDEX_KEY=cAl7bpUFzwwBOwGddJaBgsM8VTXReGQCaXLv+s7x9rM=
# Days a decision record is kept before it is purged (each purge is audited). Default: five years.
DONKA_DECISION_LOG_RETENTION_DAYS=1825

# OpenTelemetry (off by default): traces and request metrics exported over OTLP (HTTP).
# Where to send them comes from the standard OpenTelemetry variables, e.g.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ...
# Spans carry the request id and route template, never paths, query strings or bodies.
DONKA_OTEL_ENABLED=false

# Explanations (off by default): a logged decision is explained in plain language by the
# installation's own LLM endpoint. Setting the URL turns them on; then the key, the request
# format and the model are required. Before a record is sent, each project's redacted fields
# are removed, and every explanation is audited. The model gets no tools: it cannot change
# a decision.
# DONKA_EXPLAIN_URL=https://api.anthropic.com/v1/messages
# Contains a credential: never commit a real one.
# DONKA_EXPLAIN_API_KEY=
# `anthropic` (Messages API) or `openai` (OpenAI-compatible chat completions, which most
# self-hosted models serve, e.g. https://llm.bank.internal/v1/chat/completions).
# DONKA_EXPLAIN_API=anthropic
# The model name the endpoint expects.
# DONKA_EXPLAIN_MODEL=claude-opus-5-5
# Seconds to wait for an explanation.
# DONKA_EXPLAIN_TIMEOUT_SECONDS=60
# Anthropic's own API only: answer a request one model declines with another (`fallbacks`).
# DONKA_EXPLAIN_FALLBACKS=false

# Component preview checks (Node tooling only, not Studio configuration).
# Optional browser channel, e.g. msedge for an installed Microsoft Edge. CI uses downloaded Chromium.
# DONKA_TEST_BROWSER_CHANNEL=msedge
# Optional absolute path to a built Storybook; defaults to apps/web/storybook-static.
# DONKA_STORYBOOK_DIR=/absolute/path/to/storybook-static

# Live Playwright feature tests (Node tooling only). Point at an isolated synthetic-data stack.
# The full matrix needs these service origins, credentials and built CLI reference.
# Never use customer production credentials.
# DONKA_E2E_BASE_URL=http://localhost:8080
# DONKA_E2E_RUNTIME_URL=http://localhost:8090
# Production-prefix Runtime and a staging Runtime with RATE_LIMIT__REQUESTS=3 / WINDOW=60000.
# DONKA_E2E_PRODUCTION_RUNTIME_URL=http://localhost:8091
# DONKA_E2E_LIMITED_RUNTIME_URL=http://localhost:8092
# Controlled connector service: test-runner origin, then the origin reachable from Runtime.
# DONKA_E2E_BUREAU_URL=http://localhost:8099
# DONKA_E2E_CONNECTOR_URL=http://feature-bureau:8099
# Same disposable database/web export, with controlled explanations enabled.
# DONKA_E2E_EXPLAIN_STUDIO_URL=http://localhost:8083
# DONKA_E2E_EXPLAIN_SERVICE_URL=http://localhost:8100
# Controlled fixture only, when starting feature-explain.py outside Compose.
# FEATURE_EXPLAIN_KEY=feature-explain-secret
# Feed address reachable from the disposable Runtime; used by configure-feature-runtime.sh.
# DONKA_FEATURE_FEED_URL=http://app:8080/api/v1/decision-log/records
# DONKA_E2E_MAILPIT_URL=http://localhost:8025
# DONKA_E2E_ADMIN_EMAIL=admin@donka.local
# DONKA_E2E_ADMIN_PASSWORD=
# Absolute path to the verified CLI checkout, with its built dist/main.js and locked dependencies.
# CI pins the reference commit in .github/workflows/ci.yml; see docs/engineering/live-tests.md.
# DONKA_E2E_CLI_DIR=/absolute/path/to/donka-cli
# Match a fresh disposable service's small limits for test:e2e:security; never use a customer instance.
# DONKA_E2E_SIGN_IN_RATE_LIMIT=2
# DONKA_E2E_PASSWORD_RESET_RATE_LIMIT=1
# Internal only: global setup gives workers a private temporary auth-state path and removes it at teardown.
# DONKA_E2E_AUTH_FILE=

# Studio performance measurement only; scripts/check-performance.sh sets these for its
# disposable installation. Never point the seeder at customer data. Sample sizes, the 60-month
# span and request counts live in docs/performance.json, not production configuration.
# DONKA_PERFORMANCE_STUDIO_URL=http://localhost:8080
# DONKA_PERFORMANCE_EMAIL=admin@donka.local
# DONKA_PERFORMANCE_PASSWORD=
# DONKA_PERFORMANCE_PROJECT=
# DONKA_PERFORMANCE_RELEASE=
# DONKA_PERFORMANCE_DECISION=
# JSON with a synthetic input and its actual evaluated output.
# DONKA_PERFORMANCE_FIXTURE=/absolute/path/to/fixture.json
# DONKA_PERFORMANCE_STUDIO_OUT=/absolute/path/to/performance.json
